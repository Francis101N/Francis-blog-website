<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MyBlog | Categories</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
  <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
</head>
<style>
  body {
    overflow-x: hidden;
  }

  header {
    position: sticky;
    top: 0;
    z-index: 1;
  }
</style>

<body class="bg-gray-50 text-gray-900">

  <!-- Navbar -->
  <%- include('partials/header.ejs') %>

    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 text-white py-24 text-center">
      <h2 class="text-4xl md:text-5xl font-extrabold" data-aos="fade-down">Explore Categories</h2>
      <p class="mt-4 text-lg max-w-2xl mx-auto" data-aos="fade-up">
        Use the dropdown below to filter and explore blog posts by category.
      </p>
    </section>

    <!-- Filter Dropdown -->
    <section class="max-w-7xl mx-auto px-6 mt-10">
      <div class="flex justify-center mb-8">
        <select id="categoryFilter" class="px-4 py-2 border rounded-lg shadow focus:ring-2 focus:ring-indigo-500">
          <option value="all">All Categories</option>
          <% if (categories && categories.length> 0) { %>
            <% categories.forEach(cat=> { %>
              <option value="<%= cat.categoryName.toLowerCase() %>">
                <%= cat.categoryName %>
              </option>
              <% }) %>
                <% } else { %>
                  <option disabled>No categories available</option>
                  <% } %>
        </select>
      </div>
    </section>


    <!-- Categories Grid -->
    <section class="max-w-7xl mx-auto px-6 pb-16">
      <div id="categoriesGrid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <% if (posts && posts.length> 0) { %>
          <% posts.forEach((post)=> { %>
            <div class="category-card">
              <img src="/uploads/<%= post.blogImage %>" alt="<%= post.category %>" class="w-full h-56 object-cover"><br>
              <span class="bg-green-100 text-green-600 text-xs font-bold px-3 py-1 rounded-full">
                <%= post.category %>
              </span><br><br>
              <h4 class="text-xl font-semibold">
                <%= post.blogTitle %>
              </h4><br>
              <p>
                <%= post.subTitle.includes('.') ? post.subTitle.slice(0, post.subTitle.indexOf('.') + 1) : post.subTitle
                  %>
              </p>
              <div class="flex items-center mt-4 text-sm text-gray-500">
                <span>By <%= post.author %></span> •
                <span class="ml-2">
                  <%= post.createdAt.toDateString() %>
                </span>
              </div><br>

              <% if (flashPostId==post._id.toString()) { %>
                <% if (flashError) { %>
                  <div class="bg-red-100 text-red-600 px-3 py-2 rounded-lg mb-3">
                    <%= flashError %>
                  </div>
                  <% } else if (flashSuccess) { %>
                    <div class="bg-green-100 text-green-600 px-3 py-2 rounded-lg mb-3">
                      <%= flashSuccess %>
                    </div>
                    <% } %>
                      <% } %>

                        <!-- Like Button -->
                        <form action="/posts/<%= post._id %>/like" method="POST">
                          <button type="submit">👍 Like (<%= post.likes %>)</button>
                        </form>
                        <br>
                        <!-- Comment Section -->
                        <form action="/posts/<%= post._id %>/comment" method="POST">
                          <input type="text" name="name" placeholder="Your name" value="<%= user ? user.names : '' %>"
                            required readonly hidden>
                          <textarea name="message" placeholder="Your comment" style="background-color: #f9fafb;"
                            required></textarea>
                          <button type="submit"
                            class="bg-gray-400 hover:bg-gray-500 text-white font-semibold py-2 px-4 rounded">
                            💬 Comment
                          </button>

                        </form>

                        <!-- Show Comments -->
                        <h3 class="mt-4 text-gray-700 font-semibold">
                          💬 Comments (<span class="comment-count" data-id="<%= post._id %>">
                            <%= post.comments.length %>
                          </span>)
                        </h3>

                        <ul>
                          <% post.comments.slice(0, 2).forEach(comment=> { %>
                            <li><strong>
                                <%= comment.name %>:
                              </strong>
                              <%= comment.message %>
                            </li>
                            <% }) %>
                        </ul>
                        <a href="/post/readmore/<%= post._id %>"
                          class="text-indigo-600 font-semibold mt-4 inline-block hover:underline">
                          Read More & Comments →
                        </a>
            </div>
            <% }) %>
              <% } else { %>
                <p class="text-center text-gray-500">No posts found.</p>
                <% } %>
      </div>
    </section>

    <!-- Footer -->
    <%- include('partials/footer') %>

      <script>
        AOS.init({
          duration: 1000,
          once: true,
        });
      </script>

</body>

</html>